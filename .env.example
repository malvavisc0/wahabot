WAHABOT_LOG_LEVEL=INFO
WAHABOT_HOST=0.0.0.0
WAHABOT_PORT=8080
# Webhook HMAC verification (X-Webhook-Hmac, sha512) - keep in sync with WAHA hmac.key
WAHABOT_WEBHOOK_HMAC_KEY=your-secret-key
# WAHA connection for sending replies
WAHABOT_WAHA_URL=http://localhost:3000
WAHABOT_WAHA_API_KEY=your-waha-api-key
# OpenAI-compatible LLM
WAHABOT_LLM_API_BASE=https://api.openai.com/v1
WAHABOT_LLM_API_KEY=sk-your-key
WAHABOT_LLM_MODEL=gpt-4o-mini
# Sampling options — defaults follow the Qwen model card (temperature 1.0,
# top_p 0.95, top_k 20, min_p 0, no repetition penalty). The library default
# (temperature 0.1) is near-greedy and makes small models loop; if repetition
# still appears, raise WAHABOT_LLM_PRESENCE_PENALTY (up to ~2) instead of
# lowering the temperature.
WAHABOT_LLM_TEMPERATURE=1.0
WAHABOT_LLM_TOP_P=0.95
WAHABOT_LLM_TOP_K=20
WAHABOT_LLM_MIN_P=0.0
WAHABOT_LLM_PRESENCE_PENALTY=0.0
WAHABOT_LLM_REPETITION_PENALTY=1.0
# Reasoning effort for thinking models (low/medium/high); empty = provider default.
WAHABOT_LLM_REASONING_EFFORT=
# Vision: download image messages and show them to the model on that turn
# (set to false when the model rejects image inputs).
WAHABOT_VISION=true
WAHABOT_MAX_IMAGE_BYTES=10485760
# Image links in message text are fetched and shown to the model too;
# at most this many per message.
WAHABOT_MAX_URL_IMAGES=2
# Per-chat memory token ceiling (ChatMemoryBuffer); oldest messages drop first.
WAHABOT_MEMORY_TOKEN_LIMIT=8000
# Max LLM→tool round trips per agent run. Past the limit the model gets
# one final tool-free answer (early stopping) instead of a hard cut.
WAHABOT_TOOL_ROUND_LIMIT=50
# Web search tool (webserp CLI from the `webserp` package)
WAHABOT_WEB_SEARCH_MAX_RESULTS=5
WAHABOT_WEB_SEARCH_TIMEOUT=30
#WAHABOT_WEB_SEARCH_PROXY=http://proxy:8080
# Shell tool — lets the agent run arbitrary host commands. OFF by default;
# run the bot unprivileged/sandboxed before enabling.
#WAHABOT_SHELL_TOOL=true
#WAHABOT_SHELL_TIMEOUT=30
#WAHABOT_SHELL_MAX_OUTPUT=2000
# LLM observability (Langfuse) — off unless both keys are set.
# Region default is https://cloud.langfuse.com (EU); e.g.
# https://us.cloud.langfuse.com for US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
#LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment label for traces in Langfuse (empty keeps "default").
#LANGFUSE_TRACING_ENVIRONMENT=production
# Data layout: WAHABOT_DATA_DIR is the base; config lives in
# <data>/sessions/<session>.json, the event journal in <data>/events.
# Access lists (whitelist/blacklist) live in that session config file
# (session name: WAHABOT_SESSION, CLI: wahabot serve --session).
# Empty lists = answer everybody; blacklist always wins.
WAHABOT_SESSION=default
WAHABOT_DATA_DIR=data
