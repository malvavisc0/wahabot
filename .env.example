WAHABOT_LOG_LEVEL=INFO
WAHABOT_HOST=0.0.0.0
WAHABOT_PORT=8080
# Webhook HMAC verification (X-Webhook-Hmac, sha512) - keep in sync with WAHA hmac.key
WAHABOT_WEBHOOK_HMAC_KEY=your-secret-key
# WAHA connection for sending replies
WAHABOT_WAHA_URL=http://localhost:3000
WAHABOT_WAHA_API_KEY=your-waha-api-key
# OpenAI-compatible LLM
WAHABOT_LLM_API_BASE=https://api.openai.com/v1
WAHABOT_LLM_API_KEY=sk-your-key
WAHABOT_LLM_MODEL=gpt-4o-mini
# Sampling options — defaults follow the Qwen model card (temperature 1.0,
# top_p 0.95, top_k 20, min_p 0, no repetition penalty). The library default
# (temperature 0.1) is near-greedy and makes small models loop; if repetition
# still appears, raise WAHABOT_LLM_PRESENCE_PENALTY (up to ~2) instead of
# lowering the temperature.
WAHABOT_LLM_TEMPERATURE=1.0
WAHABOT_LLM_TOP_P=0.95
WAHABOT_LLM_TOP_K=20
WAHABOT_LLM_MIN_P=0.0
WAHABOT_LLM_PRESENCE_PENALTY=0.0
WAHABOT_LLM_REPETITION_PENALTY=1.0
# Reasoning effort for thinking models (low/medium/high); empty = provider default.
WAHABOT_LLM_REASONING_EFFORT=
# Ask the gateway to prompt-cache requests (Requesty auto_cache). Off by
# default; enables cached-prefix pricing for providers that support caching.
# WAHABOT_LLM_AUTO_CACHE=false
# Vision: download image messages and show them to the model on that turn
# (set to false when the model rejects image inputs).
WAHABOT_VISION=true
WAHABOT_MAX_IMAGE_BYTES=10485760
# Image links in message text are fetched and shown to the model too;
# at most this many per message.
WAHABOT_MAX_URL_IMAGES=2
# Video understanding: extract evenly spaced frames for a vision caption
# plus the spoken track via WhisperX, anchored in the turn as
# "(video shows: …) [audio: …]". Needs ffmpeg on PATH (Docker ships it).
#WAHABOT_VIDEO=true
#WAHABOT_MAX_VIDEO_BYTES=67108864
#WAHABOT_VIDEO_FRAMES=6
# Video links in message text are resolved via yt-dlp and get the same
# frames + transcript treatment as forwarded videos; at most this many
# per message (0 disables URL sniffing).
#WAHABOT_MAX_URL_VIDEOS=1
# Local files larger than this are rejected by the send_file tool
# (16 MB matches WhatsApp's own document limit).
WAHABOT_MAX_FILE_BYTES=16777216
# Local videos larger than this are rejected by the send_video tool —
# shell-tool renders grow fast and the base64 payload rides one request.
WAHABOT_MAX_VIDEO_UPLOAD_BYTES=67108864
# Local audio larger than this is rejected by the send_voice tool, and
# local sticker files by send_sticker (base64 rides one JSON request).
#WAHABOT_MAX_VOICE_UPLOAD_BYTES=16777216
#WAHABOT_MAX_STICKER_BYTES=1048576
# Human-like presence: mark incoming messages seen (set false to keep
# the account's read state untouched), and show "typing…" for a
# length-scaled random moment before the reply goes out (min 0 = off).
WAHABOT_SEND_SEEN=true
#WAHABOT_TYPING_PRESENCE_MIN_S=0.0
#WAHABOT_TYPING_PRESENCE_MAX_S=3.0
# Multi-message burst assembly: hold same-sender messages in a
# per-chat buffer so "leak" + "flat 3B" + [video] becomes ONE agent
# turn instead of one premature run per line. Inactivity window (s,
# reset by every same-sender message) plus a total hold cap (s, from
# the first buffered message — anti-abuse ceiling). Off by default:
# enable to change from per-message to per-burst replies.
WAHABOT_BURST_ENABLED=false
#WAHABOT_BURST_INACTIVITY_S=8.0
#WAHABOT_BURST_HOLD_CAP_S=30.0
# WhisperX voice-note transcription — empty WAHABOT_TRANSCRIBE_URL = feature off.
# Base URL of the /transcribe service; per-request timeout covers cold loads,
# the byte cap skips oversized notes.
#WAHABOT_TRANSCRIBE_URL=http://localhost:9191
#WAHABOT_TRANSCRIBE_TIMEOUT=300
#WAHABOT_MAX_AUDIO_BYTES=26214400
#WAHABOT_TRANSCRIBE_LANGUAGE=auto
# TTS voice synthesis behind send_voice(text=…) — empty WAHABOT_TTS_URL =
# feature off (the tool's text form errors; url/path relay still works).
# Voices/instruct are per-language maps (JSON env vars), seeded from the
# operator audition; the byte cap is the shared max_voice_upload_bytes.
#WAHABOT_TTS_URL=http://localhost:8021
#WAHABOT_TTS_TIMEOUT=120
#WAHABOT_TTS_VOICES={"en":"vd_british_male_casual","de":"vd_german_male_casual","es":"vd_spanish_male"}
#WAHABOT_TTS_INSTRUCT={"en":"","de":"","es":"spoken casually, like teasing a friend in a group chat"}
#WAHABOT_TTS_DEFAULT_LANGUAGE=en
# Per-chat memory token ceiling (ChatMemoryBuffer); oldest messages drop first.
WAHABOT_MEMORY_TOKEN_LIMIT=8000
# Persist each chat's memory to data/memory/<session>/<chat>.json so it
# survives restarts and LRU evictions. Set false to disable (blank-start
# behavior). Memory is retained forever until `wahabot forget <chat>`.
WAHABOT_MEMORY_PERSIST=true
# Max LLM→tool round trips per agent run. Past the limit the model gets
# one final tool-free answer (early stopping) instead of a hard cut.
WAHABOT_TOOL_ROUND_LIMIT=50
# Web search tool (webserp CLI from the `webserp` package)
WAHABOT_WEB_SEARCH_MAX_RESULTS=5
WAHABOT_WEB_SEARCH_TIMEOUT=30
#WAHABOT_WEB_SEARCH_PROXY=http://proxy:8080
# How long `wahabot tell` waits for the webhook reply (s). The server runs
# the whole agent turn before replying; use 0 to wait forever.
#WAHABOT_TELL_TIMEOUT=30
# Per-request LLM timeout (s). Non-streaming calls send nothing until the
# model finishes, so slow generations need a generous budget — but it
# MUST stay below the run cap, else a hung provider outlives the run.
# WAHABOT_LLM_TIMEOUT=60
# Server-side cap on a single agent run (s); keep it above the per-request
# LLM timeout (WAHABOT_LLM_TIMEOUT). Use 0 to disable the cap.
#WAHABOT_RUN_TIMEOUT=120
# Shell tool — lets the agent run arbitrary host commands. OFF by default;
# run the bot unprivileged/sandboxed before enabling.
#WAHABOT_SHELL_TOOL=true
#WAHABOT_SHELL_TIMEOUT=30
#WAHABOT_SHELL_MAX_OUTPUT=2000
# LLM observability (Langfuse) — off unless both keys are set.
# Region default is https://cloud.langfuse.com (EU); e.g.
# https://us.cloud.langfuse.com for US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
#LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment label for traces in Langfuse (empty keeps "default").
#LANGFUSE_TRACING_ENVIRONMENT=production
# Data layout: WAHABOT_DATA_DIR is the base; config lives in
# <data>/sessions/<session>.json, the event journal in <data>/events.
# Access lists (whitelist/blacklist) live in that session config file
# (session name: WAHABOT_SESSION, CLI: wahabot serve --session).
# Empty lists = answer everybody; blacklist always wins.
WAHABOT_SESSION=default
WAHABOT_DATA_DIR=data
