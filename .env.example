WHABOT_LOG_LEVEL=INFO
WHABOT_HOST=0.0.0.0
WHABOT_PORT=8080
# Webhook HMAC verification (X-Webhook-Hmac, sha512) - keep in sync with WAHA hmac.key
WHABOT_WEBHOOK_HMAC_KEY=your-secret-key
# WAHA connection for sending replies
WHABOT_WAHA_URL=http://localhost:3000
WHABOT_WAHA_API_KEY=your-waha-api-key
# OpenAI-compatible LLM
WHABOT_LLM_API_BASE=https://api.openai.com/v1
WHABOT_LLM_API_KEY=sk-your-key
WHABOT_LLM_MODEL=gpt-4o-mini
# Per-chat memory token ceiling (ChatMemoryBuffer); oldest messages drop first.
WHABOT_MEMORY_TOKEN_LIMIT=8000
# Web search tool (webserp CLI from the `webserp` package)
WHABOT_WEB_SEARCH_MAX_RESULTS=5
WHABOT_WEB_SEARCH_TIMEOUT=30
#WHABOT_WEB_SEARCH_PROXY=http://proxy:8080
# Data layout: WHABOT_DATA_DIR is the base; config lives in
# <data>/sessions/<session>.json, the event journal in <data>/events.
# Access lists (whitelist/blacklist) live in that session config file
# (session name: WHABOT_SESSION, CLI: whabot serve --session).
# Empty lists = answer everybody; blacklist always wins.
WHABOT_SESSION=default
WHABOT_DATA_DIR=data
